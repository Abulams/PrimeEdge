# Market OS Backend Environment
# ================================
# Copy this file to .env and fill in your API key to enable LLM reasoning.
# Without GEMINI_API_KEY, the AI Analyst uses the high-quality rule-based fallback.

# Gemini API key — enables LLM synthesis in the AI Analyst
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite:///./market_os.db
