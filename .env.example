# PrimeEdge (Market-OS) Environment Template
# Copy this file to backend/.env and update the values

# Database & Environment
DATABASE_URL=sqlite:///./market_os.db
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://primeedge.app,https://ops.primeedge.app
SECRET_KEY=<GENERATE_A_STRONG_RANDOM_SECRET_KEY>

# Execution & Worker Settings
WORKER_ID=worker_node_1
WORKER_KEY=<SECURE_WORKER_SHARED_KEY>
MARKETOS_CLOUD_URL=https://primeedge.app
FRONTEND_URL=https://primeedge.app

# Google Gemini API (AI Analyst)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Stripe Payment Configuration
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_<YOUR_STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=pk_test_<YOUR_STRIPE_PUBLISHABLE_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<YOUR_STRIPE_WEBHOOK_SECRET>

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_<YOUR_PAYSTACK_PUBLIC_KEY>
PAYSTACK_SECRET_KEY=sk_test_<YOUR_PAYSTACK_SECRET_KEY>

# cTrader OpenAPI v2 Credentials
CTRADER_CLIENT_ID=<YOUR_CTRADER_APP_CLIENT_ID>
CTRADER_CLIENT_SECRET=<YOUR_CTRADER_APP_CLIENT_SECRET>
CTRADER_REDIRECT_URI=https://primeedge.app/api/v1/ctrader/callback

# Telegram Bot Alerts (Optional overrides)
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
