# PrimeEdge Production Web Server & Reverse Proxy Configuration
# Caddy handles automatic Let's Encrypt TLS/SSL certificates for primeedge.app

{
    admin off
}

# Canonical redirect: Permanent 301 from www to apex
www.primeedge.app {
    redir https://primeedge.app{uri} permanent
}

# Domain HTTPS Virtual Host (Canonical Host)
primeedge.app {
    reverse_proxy 127.0.0.1:8000
}

# Founder Operations Dashboard (standalone subdomain — admin only)
ops.primeedge.app {
    reverse_proxy 127.0.0.1:8000
}

# Direct VPS IP Access (fallback before or alongside DNS propagation)
:80 {
    reverse_proxy 127.0.0.1:8000
}
